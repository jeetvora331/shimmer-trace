{
  "name": "shimmer-trace",
  "version": "1.0.0",
  "description": "High-performance React skeleton loaders that automatically trace your UI dimensions. Synchronized animations, zero CLS, and one-line implementation.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeetvora331/shimmer-trace.git"
  },
  "keywords": [
    "shimmer",
    "skeleton",
    "loader",
    "react",
    "skeleton-loader",
    "loading",
    "placeholder",
    "ui"
  ],
  "author": "Jeet Vora",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jeetvora331/shimmer-trace/issues"
  },
  "homepage": "https://github.com/jeetvora331/shimmer-trace#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
